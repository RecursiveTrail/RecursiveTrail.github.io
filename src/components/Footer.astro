---
import { site } from '../content';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line/70 bg-ink-elevated">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 sm:px-8 md:flex-row md:items-start md:justify-between">
    <div class="max-w-sm space-y-3">
      <Logo />
      <p class="text-sm leading-relaxed text-mute">{site.footer.blurb}</p>
      <p class="font-mono text-xs text-mute">{site.brand.location}</p>
    </div>

    <div class="space-y-3">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-mute">Connect</p>
      <ul class="space-y-2">
        <li>
          <a class="text-sm text-paper-dim hover:text-accent" href={`mailto:${site.brand.email}`}>
            {site.brand.email}
          </a>
        </li>
        {
          site.social.map((item) => (
            <li>
              <a
                class="text-sm text-paper-dim hover:text-accent"
                href={item.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-line/50">
    <p class="mx-auto max-w-6xl px-5 py-5 font-mono text-xs text-mute sm:px-8">
      © {year} {site.footer.copyright}
    </p>
  </div>
</footer>
