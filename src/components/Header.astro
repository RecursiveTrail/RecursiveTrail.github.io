---
import { site } from '../content';
import Logo from './Logo.astro';
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-line/60 bg-ink/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="#top" class="text-paper hover:text-accent" aria-label={`${site.brand.name} home`}>
      <Logo />
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="font-mono text-xs uppercase tracking-[0.14em] text-mute transition hover:text-paper"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="rounded-md bg-accent px-3.5 py-2 text-sm font-semibold text-ink transition hover:bg-accent/90"
    >
      Get in touch
    </a>
  </div>
</header>
