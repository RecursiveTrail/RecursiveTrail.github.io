---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]} aria-hidden={false}>
  <svg
    width="28"
    height="28"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M8 24c0-6.5 4-10 8-10s8 3.5 8 10"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      class="text-accent"
    />
    <path
      d="M11 20c0-4 2.5-6.5 5-6.5s5 2.5 5 6.5"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      class="text-accent/70"
    />
    <path
      d="M14 16.5c0-2 1-3.2 2-3.2s2 1.2 2 3.2"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      class="text-paper"
    />
    <circle cx="16" cy="10" r="1.6" class="fill-accent" />
  </svg>
  <span class="font-semibold tracking-tight text-paper">Recursive Trail</span>
</span>
