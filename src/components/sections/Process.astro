---
import { site } from '../../content';
import Section from '../ui/Section.astro';

const { process } = site;
---

<Section
  id={process.id}
  eyebrow={process.eyebrow}
  title={process.title}
  subtitle={process.subtitle}
  class="bg-ink-elevated/40"
>
  <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      process.steps.map((step, i) => (
        <li class="reveal relative" style={`animation-delay: ${i * 70}ms`}>
          <p class="font-mono text-2xl font-medium text-accent/80">{step.number}</p>
          <h3 class="mt-3 text-lg font-semibold text-paper">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mute">{step.description}</p>
        </li>
      ))
    }
  </ol>
</Section>
