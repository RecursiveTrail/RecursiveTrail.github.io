---
import { site } from '../../content';
import Section from '../ui/Section.astro';

const { projects } = site;
---

<Section
  id={projects.id}
  eyebrow={projects.eyebrow}
  title={projects.title}
  subtitle={projects.subtitle}
  class="bg-ink-elevated/40"
>
  <ul class="grid gap-6 lg:grid-cols-2">
    {
      projects.items.map((project, i) => (
        <li class="reveal" style={`animation-delay: ${i * 80}ms`}>
          <article class="flex h-full flex-col rounded-2xl border border-line bg-ink p-6 shadow-[0_0_0_1px_rgba(61,222,168,0.06)] transition hover:border-accent/40 sm:p-8">
            <div class="flex items-start gap-4">
              {'image' in project && project.image ? (
                <img
                  src={project.image}
                  alt={project.imageAlt}
                  width="88"
                  height="88"
                  class="size-[88px] shrink-0 rounded-2xl border border-line bg-ink-soft object-cover"
                />
              ) : (
                <div
                  class="flex size-[88px] shrink-0 items-center justify-center rounded-2xl border border-line bg-ink-soft font-mono text-2xl font-medium tracking-tight text-accent"
                  aria-hidden="true"
                >
                  {'initials' in project ? project.initials : project.name.slice(0, 2)}
                </div>
              )}
              <div class="min-w-0 pt-1">
                <p class="font-mono text-xs uppercase tracking-[0.14em] text-accent">{project.tagline}</p>
                <h3 class="mt-2 text-2xl font-semibold tracking-tight text-paper sm:text-3xl">{project.name}</h3>
              </div>
            </div>
            <p class="mt-5 flex-1 text-sm leading-relaxed text-mute sm:text-base">{project.description}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <li class="rounded border border-line bg-ink-soft px-2.5 py-1 font-mono text-xs text-paper-dim">
                  {tag}
                </li>
              ))}
            </ul>
            {'link' in project && project.link && (
              <p class="mt-6">
                <a
                  href={project.link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-md bg-accent px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-accent/90"
                >
                  {project.link.label}
                  <span aria-hidden="true">→</span>
                </a>
                {'secondary' in project.link && project.link.secondary && (
                  <a
                    href={project.link.secondary.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ml-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition hover:text-accent/80"
                  >
                    {project.link.secondary.label}
                    <span aria-hidden="true">→</span>
                  </a>
                )}
                {'note' in project.link && project.link.note && (
                  <span class="mt-2 block text-sm text-mute">{project.link.note}</span>
                )}
              </p>
            )}
          </article>
        </li>
      ))
    }
  </ul>
</Section>
