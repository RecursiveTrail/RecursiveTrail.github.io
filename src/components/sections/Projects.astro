---
import { site } from '../../content';
import Section from '../ui/Section.astro';

const { projects } = site;
---

<Section
  id={projects.id}
  eyebrow={projects.eyebrow}
  title={projects.title}
  subtitle={projects.subtitle}
>
  <ul class="space-y-10">
    {
      projects.items.map((project, i) => (
        <li
          class="reveal grid gap-6 border-t border-line pt-8 sm:grid-cols-[auto_1fr] sm:gap-8"
          style={`animation-delay: ${i * 80}ms`}
        >
          {'image' in project && project.image ? (
            <img
              src={project.image}
              alt={project.imageAlt}
              width="96"
              height="96"
              class="size-24 rounded-2xl border border-line bg-ink-soft object-cover"
            />
          ) : (
            <div
              class="flex size-24 items-center justify-center rounded-2xl border border-line bg-ink-soft font-mono text-lg font-medium tracking-tight text-accent"
              aria-hidden="true"
            >
              {'initials' in project ? project.initials : project.name.slice(0, 2)}
            </div>
          )}
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-accent">{project.tagline}</p>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight text-paper">{project.name}</h3>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mute sm:text-base">{project.description}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <li class="rounded border border-line bg-ink-soft px-2.5 py-1 font-mono text-xs text-paper-dim">
                  {tag}
                </li>
              ))}
            </ul>
            {'link' in project && project.link && (
              <p class="mt-5">
                <a
                  href={project.link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-accent transition hover:text-accent/80"
                >
                  {project.link.label}
                  <span aria-hidden="true">→</span>
                </a>
                {'note' in project.link && project.link.note && (
                  <span class="mt-1 block text-sm text-mute">{project.link.note}</span>
                )}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</Section>
