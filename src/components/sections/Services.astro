---
import { site } from '../../content';
import Section from '../ui/Section.astro';

const { services } = site;
---

<Section id={services.id} eyebrow={services.eyebrow} title={services.title} subtitle={services.subtitle}>
  <ul class="grid gap-6 sm:grid-cols-2">
    {
      services.items.map((item, i) => (
        <li
          class="reveal border-t border-line pt-6"
          style={`animation-delay: ${i * 60}ms`}
        >
          <h3 class="text-lg font-semibold text-paper">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mute sm:text-base">{item.description}</p>
        </li>
      ))
    }
  </ul>
</Section>
