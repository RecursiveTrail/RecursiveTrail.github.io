---
import { site } from '../../content';
import Section from '../ui/Section.astro';

const { team } = site;
---

<Section id={team.id} eyebrow={team.eyebrow} title={team.title} subtitle={team.subtitle}>
  <ul class="grid gap-10 sm:grid-cols-2">
    {
      team.members.map((member, i) => (
        <li class="reveal flex gap-5" style={`animation-delay: ${i * 80}ms`}>
          <a
            href={member.profile}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${member.name}'s profile`}
            class="size-[88px] shrink-0 rounded-full"
          >
            <img
              src={member.photo}
              alt=""
              width="88"
              height="88"
              class="size-[88px] rounded-full border border-line bg-ink-soft object-cover transition hover:border-accent"
            />
          </a>
          <div>
            <h3 class="text-lg font-semibold">
              <a
                href={member.profile}
                target="_blank"
                rel="noopener noreferrer"
                class="text-paper hover:text-accent"
              >
                {member.name}
              </a>
            </h3>
            <p class="mt-1 font-mono text-xs uppercase tracking-[0.14em] text-accent">{member.role}</p>
            <p class="mt-3 text-sm leading-relaxed text-mute">{member.bio}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
