---
import { site } from '../../content';
import Section from '../ui/Section.astro';

const { stack } = site;
---

<Section
  id={stack.id}
  eyebrow={stack.eyebrow}
  title={stack.title}
  subtitle={stack.subtitle}
  class="bg-ink-elevated/40"
>
  <div class="grid gap-10 sm:grid-cols-3">
    {
      stack.groups.map((group, i) => (
        <div class="reveal" style={`animation-delay: ${i * 80}ms`}>
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.16em] text-accent">{group.label}</p>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded border border-line bg-ink-soft px-3 py-1.5 font-mono text-xs text-paper-dim">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
